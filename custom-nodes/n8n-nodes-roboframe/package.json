{
	"name": "n8n-nodes-roboframe",
	"version": "0.1.0",
	"description": "RoboFrame (IB-Robot) skill nodes for n8n",
	"license": "MIT",
	"keywords": [
		"n8n-community-node-package"
	],
	"files": [
		"dist"
	],
	"scripts": {
		"build": "n8n-node build && node scripts/bundle-runtime.mjs",
		"lint": "n8n-node lint",
		"test": "vitest run nodes",
		"typecheck": "tsc --noEmit"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/RoboFrameBridgeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CompetitionDesign/CompetitionDesign.node.js",
			"dist/nodes/RobotCatalog/RobotCatalog.node.js",
			"dist/nodes/RobotStatus/RobotStatus.node.js",
			"dist/nodes/RobotSkill/RobotSkill.node.js",
			"dist/nodes/RobotValidate/RobotValidate.node.js",
			"dist/nodes/RobotTask/RobotTask.node.js",
			"dist/nodes/RobotSkillPlan/RobotSkillPlan.node.js"
		]
	},
	"devDependencies": {
		"@n8n/blockly-data-transform": "workspace:*",
		"@n8n/blockly-robot-skills": "workspace:*",
		"@n8n/competition-designer": "workspace:*",
		"@n8n/node-cli": "^0.44.3",
		"esbuild": "catalog:",
		"n8n-workflow": "workspace:*",
		"typescript": "^5.9.2",
		"vitest": "^4.1.9"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"homepage": "https://n8n.io",
	"author": {
		"name": "RoboFrame integration contributors"
	}
}
