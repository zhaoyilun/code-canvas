# Offline-hardened n8n environment for the RK3588 kiosk appliance.
# Copy to env.offline (next to docker-compose.yml) and fill in the two
# secrets before first boot. Keep env.offline backed up: N8N_ENCRYPTION_KEY
# decrypts all stored credentials — losing it loses every credential.

# --- identity & binding (loopback only; the kiosk browser is on this device) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# --- secrets (MUST fill in; generate with: openssl rand -hex 24) ---
N8N_ENCRYPTION_KEY=__FILL_ME__
# Matches the bridge token in /etc/roboframe-bridge.env — but note the token
# itself lives in an n8n credential created in the UI, not here. This entry is
# only a reminder; remove after creating the credential.

# --- offline hardening: disable every outbound-calling feature ---
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
# Community templates/catalog and AI features need the internet; keep off.
N8N_AI_ENABLED=false

# --- execution model for this fork ---
# Blockly Code nodes execute via the task runner; internal mode = in-process
# child, no broker port, no external launcher — the only mode that makes sense
# on a single offline device.
N8N_RUNNERS_MODE=internal

# --- persistence ---
# SQLite on the mounted volume is the right choice for one offline device.
# N8N_USER_FOLDER=/home/node/.n8n (volume-managed, see docker-compose.yml)

# --- misc ---
GENERIC_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai
# Logs to journald via docker; keep default level for on-screen debugging.
N8N_LOG_LEVEL=warn
