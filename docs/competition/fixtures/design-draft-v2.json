{
  "schemaVersion": "2.0",
  "designId": "lesson.ai-code-understanding",
  "revisionId": "revision-2",
  "name": "AI 可解释机器人课程 · Blockly Logic v2",
  "logicNodes": [
    {
      "nodeRef": "logic.normalize-lesson-input",
      "label": "规范化课程输入",
      "outputMode": "copyInput",
      "statements": [
        {
          "kind": "set",
          "intentStepId": "logic.normalize-score",
          "targetField": "normalizedScore",
          "value": {
            "kind": "arithmetic",
            "op": "multiply",
            "left": {
              "kind": "convert",
              "to": "number",
              "value": {
                "kind": "input",
                "path": "score"
              }
            },
            "right": {
              "kind": "number",
              "value": 1.2
            }
          },
          "teaching": {
            "what": "把输入分数转换为数字并乘以 1.2",
            "why": "让学员观察类型转换和乘法积木对应的 JavaScript",
            "editable": [
              "输入字段 score",
              "倍率 1.2",
              "输出字段 normalizedScore"
            ],
            "expectedEffect": "输出包含统一量纲的 normalizedScore"
          }
        },
        {
          "kind": "set",
          "intentStepId": "logic.select-active-students",
          "targetField": "activeStudentNames",
          "value": {
            "kind": "arrayMapPath",
            "path": "profile.name",
            "array": {
              "kind": "arrayFilterPath",
              "array": {
                "kind": "input",
                "path": "students"
              },
              "path": "active",
              "op": "eq",
              "value": {
                "kind": "boolean",
                "value": true
              }
            }
          },
          "teaching": {
            "what": "筛选活跃学员并读取姓名",
            "why": "展示数组筛选和字段映射如何替代 Code 节点",
            "editable": [
              "数组路径 students",
              "筛选字段 active",
              "姓名路径 profile.name"
            ],
            "expectedEffect": "activeStudentNames 只包含活跃学员姓名"
          }
        }
      ]
    }
  ],
  "robotPlan": {
    "schemaVersion": 1,
    "planRef": "plan.observe-and-greet",
    "label": "观察并问候",
    "robotProfileRef": "rk3588_training_arm",
    "catalogDigest": "rk3588-classroom-demo-v2",
    "budgetSec": 90,
    "steps": [
      {
        "stepRef": "robot.observe",
        "kind": "skill",
        "name": "inspect_scene",
        "teaching": {
          "what": "观察场景",
          "why": "先获取环境信息再执行动作",
          "editable": [],
          "expectedEffect": "形成可供后续判断使用的场景状态"
        }
      },
      {
        "stepRef": "robot.pause",
        "kind": "wait",
        "durationMs": 500
      },
      {
        "stepRef": "robot.wave",
        "kind": "skill",
        "name": "wave_hello",
        "when": {
          "field": "last.success",
          "op": "eq",
          "value": true
        }
      }
    ]
  }
}
