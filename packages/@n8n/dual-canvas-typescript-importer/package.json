{
	"name": "@n8n/dual-canvas-typescript-importer",
	"version": "0.1.0",
	"description": "Source-equivalent JavaScript, TypeScript, and ArkTS teaching-subset importer for dual-canvas visual programs",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**/*.d.ts",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"examples"
	],
	"sideEffects": false,
	"scripts": {
		"clean": "rimraf dist .turbo",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"format": "biome format --write src examples README.md package.json eslint.config.mjs tsconfig.json tsconfig.build.json vitest.config.ts",
		"format:check": "biome ci src examples README.md package.json eslint.config.mjs tsconfig.json tsconfig.build.json vitest.config.ts",
		"lint": "eslint . --quiet",
		"test": "vitest run",
		"test:unit": "vitest run"
	},
	"dependencies": {
		"@n8n/dual-canvas-core": "workspace:*",
		"@n8n/dual-canvas-operation-runtime": "workspace:*",
		"@n8n/dual-canvas-operation-sdk": "workspace:*",
		"typescript": "catalog:typescript-tooling",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@n8n/blockly-data-transform": "workspace:*",
		"@n8n/eslint-config": "workspace:*",
		"@n8n/typescript-config": "workspace:*",
		"@n8n/vitest-config": "workspace:*",
		"eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"license": "MIT"
}
